#!/bin/bash

# Sketchybar config — rift + FiraCode Nerd Font, Catppuccin Mocha
# Документация: https://felixkratz.github.io/SketchyBar/

# launchd-агент запускает конфиг с пустым PATH — подмешиваем nix-профиль
export PATH="/run/current-system/sw/bin:$PATH"
# CONFIG_DIR sketchybar выставляет сам, но при ручном запуске — нет
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Панель #####
# height=32 — 1 в 1 с меню-баром macOS на этом MacBook (safeAreaInsets.top = 32),
# чтобы панель ровно входила в чёлку
sketchybar --bar position=top \
           height=32 \
           corner_radius=0 \
           blur_radius=30 \
           color=0xb21e1e2e \
           shadow=on \
           sticky=on 

##### Дефолты для айтемов #####
sketchybar --default updates=when_shown \
           icon.font="FiraCode Nerd Font:Bold:13.0" \
           label.font="FiraCode Nerd Font:Bold:12.0" \
           icon.color=0xffcdd6f4 \
           label.color=0xffcdd6f4 \
           icon.padding_left=7 \
           icon.padding_right=3 \
           label.padding_left=3 \
           label.padding_right=7 \
           background.color=0x40313244 \
           background.corner_radius=7 \
           background.height=24

##### Кастомные события rift #####
sketchybar --add event rift_workspace_changed \
           --add event rift_windows_changed \
           --add event rift_window_title_changed

##### Активное приложение + заголовок окна (слева) #####
sketchybar --add item front_app left \
  --set front_app icon.drawing=off \
    label.color=0xfff9e2af \
    label.padding_left=10 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched rift_window_title_changed

##### Правая сторона: часы, громкость, батарея, wifi #####
sketchybar --add item clock right \
  --set clock update_freq=10 icon="󰥔" script="$PLUGIN_DIR/clock.sh"

sketchybar --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item wifi right \
  --set wifi update_freq=30 script="$PLUGIN_DIR/wifi.sh"

##### Раскладка клавиатуры (RU/EN) #####
sketchybar --add item input_source right \
  --set input_source update_freq=2 \
    label.color=0xff89b4fa \
    label.padding_left=8 \
    script="$PLUGIN_DIR/input_source.sh"

##### Воркспейсы rift (справа, перед раскладкой) #####
# Активный воркспейс — синяя «пилюля», занятые — яркие, пустые — приглушённые.
# Состояние обновляется по событиям rift_workspace_changed / rift_windows_changed
# (подписки — в run_on_start конфига rift + страховка в конце этого файла).
# Правая сторона заполняется справа налево, поэтому добавляем 9..0 —
# на панели читается 1..10 слева направо.
RIFT_WS_COUNT=10
for i in $(seq $((RIFT_WS_COUNT - 1)) -1 0); do
  sketchybar --add item "rift_ws.$i" right \
    --set "rift_ws.$i" \
      icon="$((i + 1))" \
      icon.padding_left=8 \
      icon.padding_right=8 \
      icon.color=0xff6c7086 \
      background.drawing=off \
      label.drawing=off \
      script="$PLUGIN_DIR/rift_workspace.sh" \
      click_script="/run/current-system/sw/bin/rift-cli execute workspace switch $i" \
    --subscribe "rift_ws.$i" rift_workspace_changed rift_windows_changed
done

sketchybar --update

# первичное обновление воркспейсов rift (до первого события от rift)
sketchybar --trigger rift_workspace_changed
# первичное заполнение заголовка окна
sketchybar --trigger rift_window_title_changed

##### Подписки на события rift (страховка) #####
# Основное место регистрации — run_on_start в конфиге rift (подписки живут
# внутри rift и слетают при его рестарте). Здесь — идемпотентная перестраховка
# на случай рестарта sketchybar после рестарта rift. rift дедуплицирует
# одинаковые подписки, дублей не будет.
for ev in workspace_changed windows_changed window_title_changed; do
  /run/current-system/sw/bin/rift-cli subscribe cli --event "$ev" \
    --command sh --args -c --args "/run/current-system/sw/bin/sketchybar --trigger rift_$ev" \
    >/dev/null 2>&1
done
echo "sketchybar config loaded"
